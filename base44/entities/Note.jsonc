{
  "name": "Note",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "subject_id": {
      "type": "string",
      "title": "Subject Id"
    },
    "subject_name": {
      "type": "string",
      "title": "Subject Name"
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "title": "Pinned"
    },
    "color": {
      "type": "string",
      "default": "indigo",
      "title": "Color"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}